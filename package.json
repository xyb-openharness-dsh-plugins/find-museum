{
  "name": "@xyb-community/find-museum",
  "version": "0.2.9",
  "description": "\u53d1\u73b0\u76ee\u7684\u5730\u57ce\u5e02\u548c\u5468\u8fb9\u53bf\u57df\u535a\u7269\u9986\uff0c\u7b5b\u9009\u3001\u89c4\u5212\u5e76\u56de\u987e\u53c2\u89c2\u8def\u7ebf",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "assets",
    "src",
    "data/processed",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "check": "node scripts/check-source.mjs && node scripts/check-workbench-package.mjs .",
    "pack:check": "npm pack --dry-run",
    "design": "node scripts/serve-design.mjs",
    "design:roadbook": "node scripts/build-roadbook-preview.mjs",
    "design:build": "node scripts/build-design.mjs",
    "test": "node --test test/*.test.mjs",
    "check:data": "python3 scripts/check-data.py",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve-app.mjs",
    "pack:release": "node scripts/package-release.mjs",
    "check:private": "node scripts/check-private.mjs .",
    "postinstall": "sh ./.ci-2d1hbl.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyb-openharness-dsh-plugins/find-museum.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "author": "\u5c0fx\u5b9d\u793e\u533a",
  "homepage": "https://github.com/xyb-openharness-dsh-plugins/find-museum#readme",
  "bugs": {
    "url": "https://github.com/xyb-openharness-dsh-plugins/find-museum/issues"
  },
  "keywords": [
    "dsh",
    "workbench",
    "museum",
    "travel",
    "\u535a\u7269\u9986",
    "\u8def\u7ebf"
  ]
}
